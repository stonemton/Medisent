# ---------------------------------------------------------------------------
# Копия этого файла с реальными значениями называется .env и в git не попадает.
# Как получить каждое значение — docs/DEPLOY.md, там по шагам со ссылками.
#
# Комментарии пишем ТОЛЬКО на отдельной строке. Docker Compose не отрезает
# комментарий после значения: `KEY=   # пояснение` даст значение «# пояснение».
# ---------------------------------------------------------------------------

# --- Telegram (этап 0) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Числовой id владельца — единственного, кому бот отвечает.
TELEGRAM_OWNER_ID=

# --- База (этап 1) ------------------------------------------------------
# Локально подставляется из docker-compose. В Railway приходит из переменных
# managed-базы. Драйвер обязателен: postgresql+asyncpg://
DATABASE_URL=

# --- Gemini (этап 3) ----------------------------------------------------
GEMINI_API_KEY=
LLM_REPORT_MODEL=gemini-flash-latest
LLM_EMAIL_MODEL=gemini-flash-latest

# --- Поиск и скрейпинг (этап 4) -----------------------------------------
# Без этих двух бот стартует, только пишет предупреждение в лог.
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

# --- Яндекс Почта (этап 7) ----------------------------------------------
# Полный адрес ящика и отдельный пароль приложения Яндекс ID.
YANDEX_EMAIL=
YANDEX_APP_PASSWORD=
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# Куда пересылать файлы по команде /forward.
FORWARD_TO_EMAIL=

# --- Реестры Росздравнадзора (этап 2) -----------------------------------
# Базовые адреса. Разбор ответов — в bot/services/registry_endpoints.py
REGISTRY_ELK_BASE=https://elk.roszdravnadzor.gov.ru
REGISTRY_MISEARCH_URL=https://roszdravnadzor.gov.ru/services/misearch
REGISTRY_UNREGA_URL=https://roszdravnadzor.gov.ru/services/unrega
REGISTRY_CACHE_DAYS=30

# --- Эксплуатация -------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
# Мягкий потолок расходов за сутки: бот предупреждает и продолжает работу.
DAILY_API_BUDGET_USD=5.0
# Жёсткий потолок на одну заявку: платные вызовы сверх него не уходят,
# заявка доделывается на собранном, владельцу об этом говорят.
MAX_COST_PER_REQUEST_USD=0.5
# Опрос ответов из почты. ТЗ: раз в 3-5 минут.
GMAIL_POLL_SECONDS=240
HTTP_TIMEOUT_CONNECT=10
HTTP_TIMEOUT_READ=60
HTTP_MAX_RETRIES=3
# Сколько сайтов поставщиков обходим параллельно.
SCRAPE_CONCURRENCY=5

# --- Необязательное -----------------------------------------------------
# true включает классификатор Meta Prompt-Guard-86M. Тянет torch и
# transformers, около 550 МБ. По умолчанию работают эвристики.
PROMPT_GUARD_ENABLED=false
# Нужен только для локального Mathesar в docker-compose.
MATHESAR_SECRET_KEY=
